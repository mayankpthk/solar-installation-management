# SolarOS Environment Variables

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Keys (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Private Admin Service Role Key (NEVER expose to client/frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Enterprise Defaults
DEFAULT_ORGANIZATION_ID="00000000-0000-0000-0000-000000000001"
DEFAULT_MIN_ADVANCE_PERCENT="20"
DEFAULT_GST_RATE_PERCENT="12"
